# Copia este archivo como .env para desarrollo local (NO lo subas con datos reales).

# Cadena de conexión ADO.NET de Azure SQL Database (portal → Base de datos SQL → Cadenas de conexión → ADO.NET)
SQL_CONNECTION_STRING=Server=tcp:SERVIDOR.database.windows.net,1433;Initial Catalog=pedalafondo;Persist Security Info=False;User ID=USUARIO;Password=CLAVE;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;

# Token para consultar las inscripciones en /admin y GET /api/inscripciones
ADMIN_TOKEN=cambia-este-token

# Ejecuta automáticamente el esquema y los datos iniciales al arrancar (true/false)
AUTO_MIGRATE=true

# Puerto local del servidor Node (Azure lo define solo con PORT)
PORT=3000
